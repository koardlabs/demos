    <scenes>
        <!--Launch Screen-->
        <!--
            Solid white background + centered Koard wordmark.
            koardLogo is now a PNG (1x/2x/3x rasterizations of the
            original PDF) — launch storyboards load PNG assets
            reliably; PDF asset loading from this context is flaky,
            which is why the previous version showed blank white.

            The SwiftUI LaunchOverlay shows IDENTICAL content the
            moment SwiftUI mounts (same white background, same logo,
            plus a "Koard" wordmark + spinner). The handoff from
            storyboard → SwiftUI is visually seamless because both
            backgrounds and the logo positions match.
        -->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="koardLogo" translatesAutoresizingMaskIntoConstraints="NO" id="kdo-Pj-Gpa">
                                <rect key="frame" x="56.5" y="406" width="280" height="40"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
