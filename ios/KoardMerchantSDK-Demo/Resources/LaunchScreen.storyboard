                            <constraint firstItem="kdo-Pj-Gpa" firstAttribute="width" relation="lessThanOrEqual" constant="320" id="r2N-bQ-Gso"/>
                            <constraint firstAttribute="trailing" secondItem="kdo-Pj-Gpa" secondAttribute="trailing" relation="greaterThanOrEqual" constant="40" id="hVf-cR-vN3"/>
                            <constraint firstItem="kdo-Pj-Gpa" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" relation="greaterThanOrEqual" constant="40" id="mU8-bC-Lvr"/>
